# Copia este archivo a .env y ajusta los valores.
# Puerto interno de la app.
PORT=3007
# Interfaz de escucha. Detrás de nginx, ponlo en 127.0.0.1. Sin esta línea
# escucha en todas las interfaces (0.0.0.0).
#HOST=127.0.0.1
# Clave del administrador (la que desbloquea toda la funcionalidad). CÁMBIALA.
ADMIN_PASS=cambia-esta-clave
# Dominio(s) desde los que se permite llamar a la API (separados por coma),
# p. ej. https://elecciones.ine.mx. Sin definir esta variable se acepta
# cualquier origen — cómodo en desarrollo local, pero debe fijarse antes de
# exponer el sistema a internet.
#CORS_ORIGIN=https://elecciones.ine.mx
